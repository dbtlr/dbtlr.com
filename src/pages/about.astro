---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';

const now = [
  { label: 'Building', value: 'Open-source tools for AI-native development' },
];
const elsewhere = [
  { label: 'GitHub', value: 'github.com/dbtlr', href: 'https://github.com/dbtlr', external: true },
  { label: 'LinkedIn', value: 'linkedin.com/in/drewbutler', href: 'https://linkedin.com/in/drewbutler', external: true },
  { label: 'Email', value: 'hi@dbtlr.com', href: 'mailto:hi@dbtlr.com', external: false },
];
---
<Base title="About | Drew Butler" description="Drew Butler, a product-focused engineer and engineering leader building open-source tooling for agentic, AI-native development. Based in Brooklyn." current="about">
  <div class="col">
    <div class="pt-12">
      <h1 class="m-0 mb-4.5 text-[34px] font-semibold tracking-[-0.015em] max-md:text-[28px]">Hi, I’m Drew.</h1>
      <div class="body">
        <p>I’m a product-focused engineer and engineering leader. Twenty years in, I’ve never stopped writing code. I think the best technical leaders keep their hands on the work, and it keeps me honest about the trade-offs. Lately I’m focused on agentic engineering: building the open-source tooling and workflows for how software gets made next.</p>
        <p>I care about <b>why</b> something is being built, not just how. My best work happens close to the problem: talking to users, learning the workflow, making architectural calls that serve the product rather than the tech. I’ve led distributed teams since before remote was normal, and I’d still rather reach for the right boring tool than the trendy one.</p>
        <p>Right now I’m building tools for the work around the code: keeping knowledge useful, tracking decisions and tasks, building command applications, and sharing results. That work spans <a href="/projects/">norn, mimir, Loom, Artifacts, and skald</a>.</p>
      </div>
    </div>

    <section class="mt-10">
      <SectionHead label="Now" />
      <div class="flex flex-col">
        {now.map((row) => (
          <div class="flex gap-4 py-3.5 border-b border-line text-[15px]">
            <b class="font-semibold min-w-30">{row.label}</b><span class="text-text-2">{row.value}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <SectionHead label="Elsewhere" />
      <div class="flex flex-col">
        {elsewhere.map((row) => (
          <a
            class="group flex gap-4 py-3.5 border-b border-line text-[15px]"
            href={row.href}
            target={row.external ? '_blank' : undefined}
            rel={row.external ? 'noopener noreferrer' : undefined}
          >
            <b class="font-semibold min-w-30">{row.label}</b><span class="text-text-2 transition-colors duration-120 group-hover:text-accent-cool">{row.value}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
